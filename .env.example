# ============================================================================
# RallyHub — variables de entorno. Copia este archivo a ".env" y ajusta.
# ¡Los valores de abajo son EJEMPLOS INSEGUROS solo para desarrollo local!
# Nunca subas ".env" a Git. En producción usa secretos reales y ENVIRONMENT=production.
# ============================================================================
ENVIRONMENT=development          # development | test | production
SECRET_KEY=change-me-dev-only-0123456789abcdef0123456789abcdef   # >= 32 caracteres
COOKIE_SECURE=false              # true OBLIGATORIO en producción (HTTPS)
ALLOWED_ORIGINS=                 # vacío = solo mismo origen (recomendado)
DOCS_ENABLED=true                # Swagger en /docs (desactívalo en producción)
LOG_LEVEL=INFO
APP_PORT=8000

# --- Base de datos (MariaDB en el contenedor "db") ---
DB_ROOT_PASSWORD=change-me-root-dev-only
DB_NAME=rallyhub
DB_USER=rallyhub
DB_PASSWORD=change-me-db-dev-only

# --- Reglas de negocio (horario local del club) ---
TIMEZONE=America/Bogota
OPENING_TIME=08:00
CLOSING_TIME=21:00
RESERVATION_MIN_MINUTES=30
RESERVATION_MAX_MINUTES=120
RESERVATION_MAX_ADVANCE_DAYS=30
CANCEL_MIN_HOURS_BEFORE=2

# --- Arranque del contenedor ---
RUN_MIGRATIONS=1                 # ejecuta "alembic upgrade head" una vez al iniciar
SEED_DEMO=1                      # carga datos ficticios (se ignora si ENVIRONMENT=production)

# --- Registro rápido de estudiantes (/registro) ---
SELF_REGISTRATION=true           # false = solo la administración crea cuentas
